// Prisma schema — PLAL "réseau de confiance humaine"

generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local (macOS/Linux), "rhel-openssl-3.0.x" pour le runtime serverless Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL : connexion poolée (pgBouncer, port 6543 sur Supabase) utilisée au runtime
  url      = env("DATABASE_URL")
  // DIRECT_URL : connexion directe (port 5432) utilisée par les migrations (prisma migrate / db push)
  directUrl = env("DIRECT_URL")
}

enum FriendshipStatus {
  pending
  accepted
  rejected
}

enum RecommendationType {
  person
  place
  activity
  service
}

enum RecommendationVisibility {
  friends
  friends_of_friends
}

enum IntroductionRequestStatus {
  pending
  accepted
  declined
}

enum IntroductionStepStatus {
  pending
  accepted
  declined
}

enum IntroductionResponseType {
  phone
  email
  social
}

enum InvitationStatus {
  pending
  accepted
  expired
}

enum NotificationType {
  friend_request
  friend_request_accepted
  introduction_request
  introduction_accepted
  introduction_declined
  invitation_accepted
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String
  emailVerified          Boolean  @default(false)
  onboardingCompleted    Boolean  @default(false)

  // Réinitialisation de mot de passe
  passwordResetToken     String?  @unique
  passwordResetExpiresAt DateTime?

  // Changement d'email
  emailChangeToken       String?  @unique
  emailChangePending     String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  profile              Profile?

  sentFriendships      Friendship[] @relation("FriendshipRequester")
  receivedFriendships  Friendship[] @relation("FriendshipReceiver")

  recommendations      Recommendation[]

  sentIntroductions     IntroductionRequest[] @relation("IntroRequester")
  introductionSteps     IntroductionStep[]

  sentInvitations      Invitation[] @relation("InvitationInviter")
  acceptedInvitations  Invitation[] @relation("InvitationAcceptedBy")

  notifications        Notification[]
  categorySuggestions  CategorySuggestion[]
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String?
  city        String?
  country     String?
  latitude    Float?
  longitude   Float?
  photoUrl    String?
  bio         String?
  phoneNumber String?  // Non visible publiquement, utilisé pour retrouver/inviter des amis
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(pending)
  blockedById String?
  blockedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId])
  @@index([status])
  @@index([blockedById])
}

model Category {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  parentId        String?
  parent          Category?        @relation("CategoryChildren", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryChildren")
  recommendations Recommendation[]

  @@index([parentId])
}

model CategorySuggestion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("pending")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Recommendation {
  id          String                   @id @default(cuid())
  userId      String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category                 @relation(fields: [categoryId], references: [id])
  title       String
  description String?
  city        String?
  latitude    Float?
  longitude   Float?
  type        RecommendationType       @default(person)
  visibility  RecommendationVisibility @default(friends_of_friends)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  introductionRequests IntroductionRequest[]

  @@index([userId])
  @@index([categoryId])
}

model IntroductionRequest {
  id              String                    @id @default(cuid())
  requesterId     String
  requester       User                      @relation("IntroRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recommendationId String
  recommendation  Recommendation            @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  message         String
  status          IntroductionRequestStatus @default(pending)
  responseType    IntroductionResponseType?
  responseValue   String?
  responseMessage String?
  currentStepId   String?                   @unique
  currentStep     IntroductionStep?         @relation("CurrentStep", fields: [currentStepId], references: [id])
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  steps IntroductionStep[] @relation("RequestSteps")

  @@index([requesterId])
  @@index([recommendationId])
}

model IntroductionStep {
  id                   String                @id @default(cuid())
  introductionRequestId String
  introductionRequest  IntroductionRequest   @relation("RequestSteps", fields: [introductionRequestId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               IntroductionStepStatus @default(pending)
  order                Int
  responseMessage      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  currentForRequest IntroductionRequest? @relation("CurrentStep")

  @@index([introductionRequestId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json             @default("{}")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}

model Invitation {
  id               String           @id @default(cuid())
  inviterId        String
  inviter          User             @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  token            String           @unique
  email            String?
  status           InvitationStatus @default(pending)
  acceptedById     String?
  acceptedBy       User?            @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([inviterId])
  @@index([status])
}
