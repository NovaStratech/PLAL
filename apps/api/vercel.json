{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install -g pnpm@9.15.9 && pnpm install --no-frozen-lockfile --prod=false",
  "buildCommand": "pnpm exec prisma generate && pnpm run build",
  "startCommand": "pnpm run start:prod",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "includeFiles": "../../node_modules/.pnpm/@prisma+client*/node_modules/.prisma/client/**",
      "maxDuration": 30,
      "memory": 512
    }
  },
  "env": {
    "DATABASE_URL": "@database_url",
    "DIRECT_URL": "@direct_url",
    "JWT_SECRET": "@jwt_secret",
    "JWT_EXPIRES_IN": "7d",
    "WEB_ORIGIN": "@web_origin"
  }
}
